# RuralBiz AI — Backend Environment Variables
# Copy this file to .env and fill in the values

# Database — SQLite for local dev (default), switch to Postgres for production
DATABASE_URL=sqlite+aiosqlite:///./ruralbiz.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ruralbiz

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — Frontend origin(s)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Environment
ENVIRONMENT=development

# Future phases — leave blank for now
GEMINI_API_KEY=
