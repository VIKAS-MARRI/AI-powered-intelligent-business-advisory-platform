### Production environment example for RuralBiz AI
# Copy this to `.env` in production and populate with secure values.

# App
APP_NAME=RuralBiz AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Database (Postgres recommended for production)
# Example: postgresql+asyncpg://user:password@db:5432/ruralbiz
DATABASE_URL=postgresql+asyncpg://ruralbiz:CHANGEME_PASSWORD@db:5432/ruralbiz

# JWT (REPLACE with a securely generated 64+ hex string)
JWT_SECRET_KEY=replace-with-very-secure-random-string

# Gemini (optional). Leave empty to use deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS - comma separated or JSON list
BACKEND_CORS_ORIGINS=["https://your-frontend.example.com"]

# Demo mode (true/false)
DEMO_MODE=false

# Logging
LOG_LEVEL=INFO

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
# RuralBiz AI — Production Environment Example
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=RuralBiz AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL recommended for production:
DATABASE_URL=postgresql+asyncpg://ruralbiz:CHANGE_PASSWORD@db:5432/ruralbiz

# SQLite (development/demo only — not recommended for production):
# DATABASE_URL=sqlite+aiosqlite:///./ruralbiz.db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins:
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ── AI / Gemini (optional) ────────────────────────────────────────────────────
# Application works without this (deterministic fallback mode).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ADVISOR=20/minute

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Enable for hackathon demonstrations:
DEMO_MODE=false

# ── Security ──────────────────────────────────────────────────────────────────
SECURE_HEADERS=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
